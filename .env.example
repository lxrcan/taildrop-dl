# Copy to .env and fill in. .env is gitignored — keep it that way.

# Bearer token the client (e.g. your iOS Shortcut) must send. Generate one:
#   openssl rand -hex 24
API_TOKEN=

# Comma-separated allowlist of Tailscale device names that may receive files.
# The first entry is the default when a request names no target.
#   tailscale status   # lists your devices
TAILDROP_TARGETS=my-phone

# Host interface to publish the API on. Use your server's Tailscale IP (100.x.y.z)
# so only your tailnet can reach it, or 127.0.0.1 while testing. Never 0.0.0.0
# on a machine with a public interface.
BIND_ADDR=127.0.0.1
PORT=8094

# Optional tuning
#MAX_WORKERS=2            # concurrent downloads
#YTDLP_MIN_AGE_DAYS=7     # on start, upgrade yt-dlp to the newest release at least this old
#LOG_CONTENT=false        # true = log URLs/titles/errors (default keeps logs content-free)
#TZ=UTC

# Optional ntfy push notifications (https://ntfy.sh or self-hosted)
#NTFY_BASE=https://ntfy.example.com
#NTFY_TOPIC=taildrop-dl
#NTFY_TOKEN=
